#!/bin/sh /etc/rc.common
# stabilizer — maintient les réglages de performance et journalise les dérives.
#
# Installe sur le HOST OpenWrt :
#   cp tools/stabilizer.sh /opt/stabilizer/stabilizer.sh
#   cp etc/init.d/stabilizer /etc/init.d/stabilizer
#   chmod +x /etc/init.d/stabilizer /opt/stabilizer/stabilizer.sh
#   /etc/init.d/stabilizer enable && /etc/init.d/stabilizer start
# Réversible :
#   /etc/init.d/stabilizer stop; /etc/init.d/stabilizer disable; rm /etc/init.d/stabilizer
#
# Inspecter sans rien changer : /opt/stabilizer/stabilizer.sh --check
# Journal des dérives : /opt/throughput-probe/stabilizer.jsonl
#
# SÛRETÉ : ne redémarre jamais toutes les radios (`wifi reload` global couperait tous les
# clients). La seule action Wi-Fi est `wifi up wifi2`, et seulement si l'AP 6 GHz est absent.

START=97
STOP=10
USE_PROCD=1

APP=/opt/stabilizer/stabilizer.sh
INTERVAL=300
DIR=/opt/throughput-probe

start_service() {
    [ -x "$APP" ] || return 1
    procd_open_instance stabilizer
    procd_set_param command "$APP" --interval "$INTERVAL" --dir "$DIR"
    procd_set_param respawn 3600 20 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    :
}
