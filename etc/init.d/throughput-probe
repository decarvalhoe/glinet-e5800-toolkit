#!/bin/sh /etc/rc.common
# throughput-probe — mesure periodique du debit WAN avec la radio en regard.
#
# Installe sur le HOST OpenWrt :
#   cp tools/throughput-probe.sh /opt/throughput-probe/throughput-probe.sh
#   cp etc/init.d/throughput-probe /etc/init.d/throughput-probe
#   chmod +x /etc/init.d/throughput-probe /opt/throughput-probe/throughput-probe.sh
#   /etc/init.d/throughput-probe enable && /etc/init.d/throughput-probe start
# Reversible :
#   /etc/init.d/throughput-probe stop; /etc/init.d/throughput-probe disable
#   rm /etc/init.d/throughput-probe
#
# SURETE : ne modifie rien. Il telecharge (fenetre bornee par --dur) et lit la radio en
# AT lecture seule. Aucune ecriture UCI, aucune action WAN, aucune commande AT de reglage.
# COUT : une fenetre de $DUR secondes toutes les $INTERVAL secondes, soit ~1,7 % du temps
# aux valeurs par defaut. Allonger --interval si la charge periodique gene.

START=96
STOP=10
USE_PROCD=1

APP=/opt/throughput-probe/throughput-probe.sh
INTERVAL=600
DUR=10
DIR=/opt/throughput-probe

start_service() {
    [ -x "$APP" ] || return 1
    procd_open_instance probe
    procd_set_param command "$APP" --interval "$INTERVAL" --dur "$DUR" --dir "$DIR"
    procd_set_param respawn 3600 20 0      # retry infini : tolere un WAN pas pret au boot
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    :
}
